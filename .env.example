# Шаблон переменных окружения. Скопируй в .env и заполни значениями.
# .env закоммичен НЕ будет (см. .gitignore). Здесь — только список без секретов.

# RPC-эндпоинт для Base Sepolia (например, из Alchemy / публичный)
BASE_SEPOLIA_RPC_URL=

# API-ключ для верификации контрактов в обозревателе (Basescan)
BASESCAN_API_KEY=

# Публичный адрес деплой-кошелька (это НЕ секрет, можно светить)
DEPLOYER_ADDRESS=

# Приватный ключ деплой-кошелька.
# ЛУЧШЕ не хранить тут вообще, а использовать зашифрованный Foundry keystore:
#   cast wallet import deployer --interactive
# и деплоить через `forge script ... --account deployer`.
# Если всё же кладёшь сюда для локальной разработки — только ОТДЕЛЬНЫЙ тестовый кошелёк.
# PRIVATE_KEY=
